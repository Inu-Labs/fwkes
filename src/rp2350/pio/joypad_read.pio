; PIO program for clocking CD4021 and reading its serial output.
.program joypad_read

; Set pins are set for strobe
; Sideset pin is for clock
; In pins is for Q8 (or Q7 if counting from 0)
.side_set 1

; PIO runs on ~1 MHz frequency, and each clock takes ~1us. According to the datasheet, clock rise
; and down time can take 10-15 us. So we'll wait for 16 us (here 15, but since each instruction
; takes 1 cycle, this will add up to 16 cycles).
.define CLK_TIME 15
.define STR_TIME 15

.wrap_target
    pull block         side 0             ; wait for order from CPU
    mov isr, null      side 0

    set pins, 1        side 0             ; STR = 1
    nop                side 0 [STR_TIME]
    set pins, 0        side 0             ; STR = 0

    set x, 7           side 0
read_bit:
    in pins, 2         side 0 [CLK_TIME]  ; CLK = 0, read outputs of both shift registers.
    jmp x-- read_bit   side 1             ; CLK = 1

    push block         side 0
.wrap

% c-sdk {
static inline void joypad_read_program_init(
    PIO pio, uint sm, uint offset, uint strobe_pin, uint clk_pin, uint data_pin) {
    pio_sm_config c = joypad_read_program_get_default_config(offset);

    gpio_init(data_pin);
    gpio_init(data_pin + 1);

    sm_config_set_set_pins(&c, strobe_pin, 1);
    pio_gpio_init(pio, strobe_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, strobe_pin, 1, true); /* true for output */

    sm_config_set_sideset_pins(&c, clk_pin);
    pio_gpio_init(pio, clk_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, clk_pin, 1, true); /* true for output */

    sm_config_set_in_pins(&c, data_pin);
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, data_pin + 1);
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 2, false); /* false for input */

    /* Program will run on ~1 MHz. Each clock cycle will take 1 / 1MHz ~ 1us. */
    float clk_div = (float) clock_get_hz(clk_sys) / 1000000.f;
    sm_config_set_clkdiv(&c, clk_div);

    /* First bits are shifted right, enable autopush */
    sm_config_set_in_shift(&c, false, false, 16);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
